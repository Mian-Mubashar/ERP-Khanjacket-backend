# ==============================================================================
# KHAN CLOTHES WAREHOUSE & INVENTORY MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (Frontend URLs allowed to connect)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (Sequelize)
# Supported DB_DIALECT: sqlite | mysql | postgres | mariadb
DB_DIALECT=sqlite

# SQLite Configuration (Default for fast, zero-dependency local dev)
DB_STORAGE=./data/warehouse.sqlite

# MySQL / PostgreSQL Configuration (For Production deployment)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=khan_warehouse_db
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# Authentication & Security (JWT)
JWT_SECRET=khan_clothes_super_secure_jwt_secret_key_2026_xyz!@#
JWT_EXPIRES_IN=7d

# Bcrypt Salt Rounds for Password Hashing
BCRYPT_SALT_ROUNDS=10

# Rate Limiting (Security & DDoS Protection)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# Hardware Device Policy Limit (Strict Khan Clothes rule: 4-5 mobile units)
MAX_AUTHORIZED_DEVICES=5

# Super Admin Initial Credentials (Used during automatic seeding)
DEFAULT_ADMIN_NAME=Admin Khan
DEFAULT_ADMIN_EMAIL=admin@khanclothes.com
DEFAULT_ADMIN_PASSWORD=admin123
