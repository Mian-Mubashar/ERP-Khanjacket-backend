{
  "name": "khan-clothes-warehouse-backend",
  "version": "1.0.0",
  "description": "Production-grade, secure Node.js + Express + Sequelize SQL Backend for Khan Clothes Warehouse & Inventory System with Granular RBAC Permissions and Migrations",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/utils/migrationRunner.js up",
    "migrate:undo": "node src/utils/migrationRunner.js down",
    "migrate:reset": "node src/utils/migrationRunner.js reset",
    "migrate:status": "node src/utils/migrationRunner.js status",
    "migrate:fresh": "node src/utils/migrationRunner.js reset && node src/utils/migrationRunner.js up && node src/seeders/initialSeeder.js",
    "seed": "node src/seeders/initialSeeder.js",
    "db:setup": "node src/utils/migrationRunner.js up && node src/seeders/initialSeeder.js",
    "cli:migrate": "npx sequelize-cli db:migrate",
    "cli:migrate:undo": "npx sequelize-cli db:migrate:undo"
  },
  "keywords": [
    "warehouse",
    "inventory",
    "express",
    "sequelize",
    "rbac",
    "permissions",
    "sql",
    "migrations"
  ],
  "author": "Senior Backend Architect",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
